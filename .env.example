# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@db:5432/agenda?sslmode=disable

# Server
PORT=4000
LOG_LEVEL=info
STORAGE_DIR=./data

# CORS — only needed if deploying client separately from the API
# DOMAINS=https://agenda.example.com

# Encryption — used to encrypt OIDC tokens at rest (optional but recommended)
ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# SSO / OIDC (optional)
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=agenda
# OIDC_CLIENT_SECRET=secret
# OIDC_REDIRECT_URL=https://agenda.example.com/auth/oidc/callback
# OIDC_SUCCESS_URL=https://agenda.example.com
# SSO_ONLY=false
