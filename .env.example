# Domain (used by Traefik for routing)
DOMAIN=agenda.example.com

# Database — required
DB_USER=agenda
DB_PASSWORD=change-me

# Optional DB overrides (defaults work with docker-compose)
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=agenda
# DB_SSLMODE=disable

# Server
PORT=4000
LOG_LEVEL=info
STORAGE_DIR=./data

# Encryption — encrypts OIDC tokens at rest (recommended)
ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# SSO / OIDC (optional)
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=agenda
# OIDC_CLIENT_SECRET=secret
# OIDC_REDIRECT_URL=https://agenda.facile.studio/auth/oidc/callback
# OIDC_SUCCESS_URL=https://agenda.facile.studio
# SSO_ONLY=false
