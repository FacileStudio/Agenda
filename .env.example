# Database — required.
# Either set DATABASE_URL, or DB_USER + DB_PASSWORD and let the API assemble the DSN.
DB_USER=agenda
DB_PASSWORD=change-me
# DATABASE_URL=postgres://agenda:change-me@db:5432/agenda?sslmode=disable

# Optional DSN parts, only read when DATABASE_URL is unset.
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=agenda
# DB_SSLMODE=disable

# Server
APP_ENV=production
PORT=4000
# LOG_LEVEL=info
# STORAGE_DIR=./data
# CLIENT_DIR=/client

# CORS — only needed when the client is served from another origin.
# Full origins, scheme included. The legacy names ALLOWED_ORIGINS, DOMAINS,
# DOMAIN, CORS_ORIGINS, TRUSTED_ORIGINS and CLIENT_ORIGIN are still read.
# CORS_ALLOWED_ORIGINS=https://agenda.example.com

# Encryption — encrypts OIDC tokens at rest (recommended)
ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# SSO / OIDC (optional).
# The callback is served at /api/auth/oidc/callback; the legacy
# /auth/oidc/callback redirects to it, so an Authentik registration on the old
# URL keeps working.
# OIDC_ISSUER=https://porte.example.com/application/o/agenda/
# OIDC_CLIENT_ID=agenda
# OIDC_CLIENT_SECRET=secret
# OIDC_REDIRECT_URL=https://agenda.example.com/auth/oidc/callback
# OIDC_SUCCESS_URL=https://agenda.example.com
# SSO_ONLY=false

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_agenda_...
